# Wealth & Portfolio Co-Pilot - Environment Configuration

# Copy this file to .env and fill in your values

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
SLM_MODEL=llama-3-8b-quantized

# Vector Database Configuration
VECTOR_DB_PATH=./data/vector_store
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Graph Database (Neo4j) - Optional
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# MCP Servers Configuration
MARKET_DATA_API_KEY=your_alpha_vantage_or_yfinance_api_key
SEC_EDGAR_EMAIL=your_email@example.com

# Guardrails Configuration
ENABLE_GUARDRAILS=true
COMPLIANCE_THRESHOLD=0.85

# Memory Configuration
MAX_EPISODIC_MEMORY=10
SEMANTIC_MEMORY_TOP_K=5

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/copilot.log
